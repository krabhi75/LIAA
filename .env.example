# Agora Console → Project → App ID
# Put this on Vercel Production (and Preview). Redeploy after adding it.
NEXT_PUBLIC_AGORA_APP_ID=
# Optional server-only alias if you cannot rebuild the client bundle
AGORA_APP_ID=

# Agora Console → Project → App Certificate (server only — never prefix NEXT_PUBLIC_)
NEXT_AGORA_APP_CERTIFICATE=
AGORA_APP_CERTIFICATE=

# US | AP | EU | CN  — US is the documented managed-model region
AGORA_AREA=US

# Public HTTPS origin Agora's cloud can reach for MCP tool calls.
# Local: cloudflared tunnel --url http://localhost:3000
# Vercel production origin (webhooks + MCP)
PUBLIC_BASE_URL=https://liaa-ebon.vercel.app

# Shared secret sent as X-Aether-Key on MCP requests
AETHER_MCP_KEY=change-me-before-demo

# Voice stack on Agora Conversational AI
# ASR: Deepgram (via Agora) · LLM: OpenAI gpt-4o-mini (via Agora) · TTS: ElevenLabs (BYOK)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_BASE_URL=wss://api.elevenlabs.io/v1

# Neon Postgres (pooled). DIRECT_URL is the non-pooler host for Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# JWT cookie signing for MolVaani Cloud auth
AUTH_SECRET=replace-with-long-random-string

# Vobiz telephony (never commit real tokens)
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_ACCOUNT_ID=
VOBIZ_FROM_NUMBER=+917971443138
VOBIZ_SIP_DOMAIN=a4dc1a99.sip.vobiz.ai
VOBIZ_OUTBOUND_TRUNK_ID=a4dc1a99-2efa-4f52-b481-5dfd99aca03d
VOBIZ_INBOUND_TRUNK_ID=c56b68cd-591f-4196-92df-e9e7a34aae9b
VOBIZ_SIP_TRUNK_REF=5c206cbc-9733-48c5-a1d0-b7b50ecbe5e8

# Optional Stripe (billing stub works without these)
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
