# Agora Console → Project → App ID (safe to expose to the browser)
NEXT_PUBLIC_AGORA_APP_ID=

# Agora Console → Project → App Certificate (server only — never prefix NEXT_PUBLIC_)
NEXT_AGORA_APP_CERTIFICATE=

# US | AP | EU | CN  — US is the documented managed-model region
AGORA_AREA=US

# Public HTTPS origin Agora's cloud can reach for MCP tool calls.
# Local: cloudflared tunnel --url http://localhost:3000
# Vercel: https://your-app.vercel.app
PUBLIC_BASE_URL=

# Shared secret sent as X-Aether-Key on MCP requests
AETHER_MCP_KEY=change-me-before-demo

# SQLite (local) — for Postgres use postgresql://...
DATABASE_URL="file:./dev.db"

# JWT cookie signing for MolVaani Cloud auth
AUTH_SECRET=replace-with-long-random-string

# Vobiz telephony (never commit real tokens)
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_ACCOUNT_ID=
VOBIZ_FROM_NUMBER=+917971443138
VOBIZ_SIP_DOMAIN=a4dc1a99.sip.vobiz.ai
VOBIZ_OUTBOUND_TRUNK_ID=a4dc1a99-2efa-4f52-b481-5dfd99aca03d
VOBIZ_INBOUND_TRUNK_ID=c56b68cd-591f-4196-92df-e9e7a34aae9b
VOBIZ_SIP_TRUNK_REF=5c206cbc-9733-48c5-a1d0-b7b50ecbe5e8

# Optional Stripe (billing stub works without these)
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
